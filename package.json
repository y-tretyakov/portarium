{
  "name": "portarium",
  "version": "0.6.0",
  "type": "module",
  "description": "Real-time port dashboard for your terminal — watch, search, kill & restart processes",
  "bin": {
    "portarium": "bin/cli.tsx"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tui": "bun run src-tui/index.tsx",
    "tui:dev": "bun --watch run src-tui/index.tsx"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/y-tretyakov/portarium.git"
  },
  "keywords": ["port", "dashboard", "terminal", "tui", "developer-tools", "process-manager"],
  "license": "MIT",
  "dependencies": {
    "@opentui/core": "^0.4.5",
    "@opentui/react": "^0.4.5",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-opener": "^2",
    "d3": "^7.9.0",
    "howler": "^2.2.4",
    "html2canvas": "^1.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/d3": "^7.4.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "bun-types": "^1.3.14",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
